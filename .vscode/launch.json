{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Backend Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "open_webui.main:app",
                "--host", "0.0.0.0",
                "--port", "8080",
                "--reload"
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/backend",
            "preLaunchTask": "Start Backend (Open WebUI)",
            "envFile": "${workspaceFolder}.env"
        },
        {
            "name": "Svelte: Frontend Debug",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Frontend (npm run dev)",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Run Full Open WebUI (Backend + Frontend)",
            "configurations": ["Python: Backend Debug", "Svelte: Frontend Debug"]
        }
    ]
}
